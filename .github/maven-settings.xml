<?xml version="1.0" encoding="UTF-8"?>
<!-- CI only: fetch Maven Central artifacts from Google's official Central mirror. The ~130 parallel jobs
     share GitHub runner IPs, and repo.maven.apache.org answers them with 429 Too Many Requests. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
