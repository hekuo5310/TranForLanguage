<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.tranforlanguage</groupId><artifactId>tranforlanguage-spigot</artifactId><version>2.3.0</version>
  <name>TranForLanguage</name>
  <description>Run C, C++, Python, Rust, JavaScript, Go, Ruby, PHP, Java and Lua programs on Minecraft servers and let them call each other.</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <spigot.version>1.8-R0.1-SNAPSHOT</spigot.version>
  </properties>
  <repositories><repository><id>spigot</id><url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url></repository></repositories>
  <dependencies>
    <!-- Use Spigot's API only. Its internal runtime libraries are supplied by the server;
         some historical snapshot POMs point to unavailable transitive versions. -->
    <dependency><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId><version>${spigot.version}</version><scope>provided</scope>
      <!-- Exclude every transitive library: the server provides them at runtime, and resolving the
           historical versions of 68 API snapshots in parallel trips Maven Central's rate limit. -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.10.1</version></dependency>
    <!-- Structural TOML editing for managed Rust Cargo manifests (bundles its parser runtime). -->
    <dependency><groupId>org.tomlj</groupId><artifactId>tomlj</artifactId><version>2.2.0</version></dependency>
    <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-minimessage</artifactId><version>4.17.0</version></dependency>
    <dependency><groupId>net.kyori</groupId><artifactId>adventure-text-serializer-legacy</artifactId><version>4.17.0</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <!-- Historical Spigot API signatures reference Guava; compile against it without bundling it. -->
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>31.1-jre</version><scope>provided</scope></dependency>
    <!-- PluginDescriptorTest uses YAML explicitly; keep the parser test-only and versioned. -->
    <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId><version>1.33</version><scope>test</scope></dependency>
    <!-- In-JVM translators: compiled against, never bundled. RuntimeLibraries downloads the pinned jars on first use. -->
    <dependency><groupId>com.dylibso.chicory</groupId><artifactId>compiler</artifactId><version>1.7.5</version><scope>provided</scope></dependency>
    <dependency><groupId>com.dylibso.chicory</groupId><artifactId>wasi</artifactId><version>1.7.5</version><scope>provided</scope></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.9.1</version><scope>provided</scope></dependency>
    <dependency><groupId>org.luaj</groupId><artifactId>luaj-jse</artifactId><version>3.0.1</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <testResources><testResource><directory>core/src/test/resources</directory></testResource></testResources>
    <resources><resource><directory>src/main/resources</directory><filtering>true</filtering></resource><resource><directory>core/src/main/resources</directory></resource><resource><directory>.</directory><includes><include>LICENSE</include></includes></resource></resources>
    <plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version><executions>
        <execution><id>core</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>core/src/main/java</source></sources></configuration></execution>
        <execution><id>tests</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>core/src/test/java</source></sources></configuration></execution>
      </executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><executions>
        <!-- Glue for the in-JVM translators targets Java 11 like the libraries it drives; it only loads on Java 11+. -->
        <execution><id>engine</id><phase>compile</phase><goals><goal>compile</goal></goals><configuration>
          <release>11</release><compileSourceRoots><compileSourceRoot>${project.basedir}/core/src/engine/java</compileSourceRoot></compileSourceRoots>
        </configuration></execution>
      </executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version><configuration>
        <systemPropertyVariables><project.version>${project.version}</project.version>
          <!-- One download of the in-JVM translators for all tests. -->
          <tranforlanguage.runtimes>${project.build.directory}/runtimes</tranforlanguage.runtimes>
        </systemPropertyVariables>
      </configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
        <createDependencyReducedPom>false</createDependencyReducedPom>
        <relocations>
          <relocation><pattern>com.google.gson</pattern><shadedPattern>com.github.tranforlanguage.internal.gson</shadedPattern></relocation>
          <relocation><pattern>org.tomlj</pattern><shadedPattern>com.github.tranforlanguage.internal.tomlj</shadedPattern></relocation>
          <relocation><pattern>net.kyori</pattern><shadedPattern>com.github.tranforlanguage.internal.kyori</shadedPattern></relocation>
        </relocations>
        <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude><exclude>META-INF/versions/**</exclude></excludes></filter></filters>
      </configuration></execution></executions></plugin>
    </plugins>
  </build>
</project>
