package com.github.tranforcpp.mixin;
import com.github.tranforcpp.minecraft.ModEvents;
import com.mojang.brigadier.ParseResults;
import net.minecraft.commands.*;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.*;
import org.spongepowered.asm.mixin.injection.callback.*;
@Mixin(Commands.class)
abstract class FabricCommandMixin {
    @Inject(method = "performCommand", at = @At("HEAD"))
    private void tranforlanguage$command(ParseResults<CommandSourceStack> results, String command, @COMMAND_CALLBACK@ ci) {
        ModEvents.emit("ServerCommand", results.getContext().getSource().getTextName(), command);
    }
}
